<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionComponentPath Condition="'$(ProductionComponentPath)' == ''">../../Medium/NewComponents/AbilitySpecific/AddSuddenAttack.cs</ProductionComponentPath>
    <ProductionBlueprintPath Condition="'$(ProductionBlueprintPath)' == ''">../../Medium/Spirits/Champion/SuddenAttack.cs</ProductionBlueprintPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionComponentPath)" Link="Production/AddSuddenAttack.cs" />
    <Compile Include="$(ProductionBlueprintPath)" Link="Production/SuddenAttack.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
